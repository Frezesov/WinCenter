<Window x:Class="WinCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinCenter.Controls"
        Title="WinCenter"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="720" Height="820" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding HideToTrayCommand}" />
    </Window.InputBindings>

    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000">

            <!-- Status and master switch; the app name and icon are already in the title bar -->
            <TextBlock Text="Состояние программы" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
            <controls:SettingsCard Glyph="{Binding StatusGlyph}" Title="{Binding StatusTitle}" Description="{Binding StatusDetails}">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"
                          ToolTip="Включить или приостановить центрирование"
                          AutomationProperties.Name="Центрирование включено" />
            </controls:SettingsCard>

            <!-- Centering -->
            <TextBlock Text="Центрирование" Style="{StaticResource SectionTitle}" />

            <controls:SettingsExpander Glyph="&#xE765;" IsExpanded="True"
                                       Title="Центрирование по сочетанию клавиш"
                                       Description="Активное окно встаёт ровно по центру экрана, на котором находится">
                <controls:SettingsExpander.HeaderContent>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HotkeyEnabled}" />
                </controls:SettingsExpander.HeaderContent>
                <controls:SettingsCard Style="{StaticResource SettingsRow}" IsEnabled="{Binding HotkeyEnabled}"
                                       Title="Сочетание клавиш"
                                       Description="Нажмите на поле и введите новое. Esc — отмена, Backspace — очистить">
                    <controls:SettingsCard.Detail>
                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HotkeyError}" />
                    </controls:SettingsCard.Detail>
                    <controls:HotkeyBox Hotkey="{Binding Hotkey}"
                                        IsCapturing="{Binding IsCapturingHotkey, Mode=OneWayToSource}"
                                        AutomationProperties.Name="Сочетание клавиш для центрирования" />
                </controls:SettingsCard>
            </controls:SettingsExpander>

            <controls:SettingsExpander Glyph="&#xE945;"
                                       Title="Автоматическое центрирование окон"
                                       Description="Окна сами встают по центру, когда появляются на экране">
                <controls:SettingsExpander.HeaderContent>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoEnabled}" />
                </controls:SettingsExpander.HeaderContent>
                <StackPanel IsEnabled="{Binding AutoEnabled}">
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Только новые окна"
                                           Description="Уже открытые окна остаются на своих местах, даже если переключиться на них">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OnlyNewWindows}" />
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Умный фильтр окон"
                                           Description="Не трогать развёрнутые окна, меню и всплывающие панели без рамки">
                        <controls:SettingsCard.Detail>
                            <Border Style="{StaticResource Badge}" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource BadgeText}" Text="рекомендуется"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </controls:SettingsCard.Detail>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SmartFilter}" />
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Мгновенная реакция"
                                           Description="30 мс вместо 300 мс. Окно может сдвинуться раньше, чем закончит появляться">
                        <controls:SettingsCard.Detail>
                            <Border Style="{StaticResource Badge}" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource BadgeText}" Text="не рекомендуется"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </Border>
                        </controls:SettingsCard.Detail>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FastReaction}" />
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Исключения"
                                           Description="Окна этих программ не центрируются автоматически. Сочетание клавиш и меню в трее работают для них как обычно">
                        <controls:SettingsCard.Detail>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource RowDescription}" Margin="0,2,0,2"
                                           Text="Список пуст — добавьте программу кнопкой справа"
                                           Visibility="{Binding HasExclusions, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding ExcludedApps}" Focusable="False"
                                              AutomationProperties.Name="Исключённые программы">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <controls:Glyph Text="&#xE7C4;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <controls:Glyph.Style>
                                                        <Style TargetType="controls:Glyph">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:Glyph.Style>
                                                </controls:Glyph>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding Exe}" Style="{StaticResource RowDescription}" Margin="0" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;"
                                                        Command="{Binding RemoveCommand}" ToolTip="Убрать из исключений"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Убрать {0} из исключений}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </controls:SettingsCard.Detail>
                        <Button x:Name="AddExclusionButton" Click="OnAddExclusion" AutomationProperties.Name="Добавить программу в исключения">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Добавить" />
                                <controls:Glyph Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                                Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsCard>
                </StackPanel>
            </controls:SettingsExpander>

            <controls:SettingsCard Glyph="&#xE7C2;" Title="Плавное перемещение"
                                   Description="Окно плавно доезжает до центра, а не прыгает. Не работает, если в Windows выключены эффекты анимации">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SmoothMove}" />
            </controls:SettingsCard>

            <!-- Window size -->
            <TextBlock Text="Размер окна" Style="{StaticResource SectionTitle}" />

            <controls:SettingsExpander Glyph="&#xE9A6;"
                                       Title="Размер окна при центрировании"
                                       Description="По умолчанию окно сохраняет свой размер. Проценты считаются от рабочей области экрана без панели задач">
                <controls:SettingsExpander.HeaderContent>
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding SizeSummary}" />
                </controls:SettingsExpander.HeaderContent>
                <StackPanel>
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Задать ширину">
                        <controls:SettingsCard.Detail>
                            <Grid Margin="0,10,0,2" Visibility="{Binding CustomWidth, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                                        Value="{Binding WidthPercent}"
                                        AutomationProperties.Name="Ширина окна в процентах" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource ValueText}"
                                           Text="{Binding WidthPercent, StringFormat={}{0}&#160;%}" />
                            </Grid>
                        </controls:SettingsCard.Detail>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CustomWidth}" />
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Задать высоту">
                        <controls:SettingsCard.Detail>
                            <Grid Margin="0,10,0,2" Visibility="{Binding CustomHeight, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                                        Value="{Binding HeightPercent}"
                                        AutomationProperties.Name="Высота окна в процентах" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource ValueText}"
                                           Text="{Binding HeightPercent, StringFormat={}{0}&#160;%}" />
                            </Grid>
                        </controls:SettingsCard.Detail>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CustomHeight}" />
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Менять размер у окон с фиксированным размером"
                                           Description="Размер меняется даже у окон, которые этого не поддерживают. Может исказить их вид">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ForceResize}" />
                    </controls:SettingsCard>
                </StackPanel>
            </controls:SettingsExpander>

            <!-- System -->
            <TextBlock Text="Система" Style="{StaticResource SectionTitle}" />

            <controls:SettingsCard Glyph="&#xE7E8;" Title="Запускать вместе с Windows"
                                   Description="Программа стартует свёрнутой в трей. Закрытое окно тоже прячется в трей — управление правой кнопкой по значку">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Autostart}" />
            </controls:SettingsCard>

            <controls:SettingsExpander Glyph="&#xE946;" Title="О программе" Description="{Binding VersionText}">
                <controls:SettingsExpander.HeaderContent>
                    <Border Style="{StaticResource Badge}" Margin="0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource BadgeText}" Text="доступно обновление"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                </controls:SettingsExpander.HeaderContent>
                <StackPanel>
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="{Binding UpdateTitle}" Description="{Binding UpdateDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding DownloadUpdateCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="{Binding DownloadUpdateText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DownloadUpdateText}" />
                                    <controls:Glyph Text="&#xE8A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                                    Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="Проверить" MinWidth="96" Command="{Binding CheckUpdatesCommand}"
                                    IsEnabled="{Binding CanCheckUpdates}" AutomationProperties.Name="Проверить обновления" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Проверять обновления автоматически"
                                           Description="Раз в сутки программа спрашивает у GitHub, вышла ли новая версия. Сама ничего не скачивает">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates}" />
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Страница проекта"
                                           Description="Исходный код, новые версии и описание на GitHub">
                        <Button Command="{Binding OpenProjectPageCommand}" AutomationProperties.Name="Открыть страницу проекта на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GitHub" />
                                <controls:Glyph Text="&#xE8A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                                Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Основано на Window Centering Helper"
                                           Description="Идея и набор функций — Kamil Szymborski. Код оригинала закрыт, эта программа написана с нуля">
                        <Button Command="{Binding OpenOriginalCommand}" AutomationProperties.Name="Открыть сайт Window Centering Helper">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Сайт автора" />
                                <controls:Glyph Text="&#xE8A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                                Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Выйти из программы"
                                           Description="Окна перестанут центрироваться до следующего запуска WinCenter">
                        <Button Content="Выйти" MinWidth="96" Command="{Binding ExitCommand}"
                                AutomationProperties.Name="Выйти из программы" />
                    </controls:SettingsCard>
                </StackPanel>
            </controls:SettingsExpander>
        </StackPanel>
    </controls:SmoothScrollViewer>
</Window>
