<Window x:Class="WindowCentering.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowCentering.Controls"
        Title="Центровка окон"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="620" Height="800" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding HideToTrayCommand}" />
    </Window.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="760">

            <!-- Header: logo, status, master switch -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Canvas Width="256" Height="256">
                        <Rectangle Width="256" Height="256" RadiusX="56" RadiusY="56" Fill="#0D9488" />
                        <Rectangle Canvas.Left="79" Canvas.Top="90" Width="98" Height="76" RadiusX="13" RadiusY="13" Fill="White" />
                        <Line X1="128" Y1="44" X2="128" Y2="64" Stroke="White" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="128" Y1="212" X2="128" Y2="192" Stroke="White" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="44" Y1="128" X2="64" Y2="128" Stroke="White" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="212" Y1="128" X2="192" Y2="128" Stroke="White" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Центровка окон" Style="{StaticResource PageTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Style="{StaticResource StatusDot}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetails}" Style="{StaticResource RowDescription}" />
                </StackPanel>

                <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding Enabled}"
                          ToolTip="Включить или приостановить центрирование"
                          AutomationProperties.Name="Центрирование включено" />
            </Grid>

            <!-- Hotkey -->
            <TextBlock Text="Сочетание клавиш" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="{StaticResource RowPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Style="{StaticResource RowIcon}" Text="&#xE765;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Центрировать по сочетанию клавиш" />
                            <TextBlock Style="{StaticResource RowDescription}"
                                       Text="Активное окно встаёт ровно по центру экрана, на котором находится" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding HotkeyEnabled}"
                                  AutomationProperties.Name="Центрировать по сочетанию клавиш" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="{StaticResource RowPadding}" IsEnabled="{Binding HotkeyEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Сочетание" />
                            <TextBlock Style="{StaticResource RowDescription}"
                                       Text="Нажмите на поле и введите новое. Esc — отмена, Backspace — очистить" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HotkeyError}" />
                        </StackPanel>
                        <controls:HotkeyBox Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Hotkey="{Binding Hotkey}"
                                            IsCapturing="{Binding IsCapturingHotkey, Mode=OneWayToSource}"
                                            AutomationProperties.Name="Сочетание клавиш для центрирования" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Automatic centering -->
            <TextBlock Text="Автоматическое центрирование" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="{StaticResource RowPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Style="{StaticResource RowIcon}" Text="&#xE945;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Центрировать автоматически" />
                            <TextBlock Style="{StaticResource RowDescription}"
                                       Text="Окна сами встают по центру, когда появляются на экране" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding AutoEnabled}"
                                  AutomationProperties.Name="Центрировать автоматически" />
                    </Grid>

                    <StackPanel IsEnabled="{Binding AutoEnabled}">
                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="{StaticResource RowPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Только новые окна" />
                                <TextBlock Style="{StaticResource RowDescription}"
                                           Text="Уже открытые окна остаются на своих местах, даже если переключиться на них" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding OnlyNewWindows}"
                                      AutomationProperties.Name="Только новые окна" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="{StaticResource RowPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1">
                                <WrapPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Умный фильтр окон" />
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="рекомендуется"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource RowDescription}"
                                           Text="Не трогать развёрнутые окна, меню и всплывающие панели без рамки" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding SmartFilter}"
                                      AutomationProperties.Name="Умный фильтр окон" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="{StaticResource RowPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1">
                                <WrapPanel>
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Мгновенная реакция" />
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="не рекомендуется"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource RowDescription}"
                                           Text="30 мс вместо 300 мс. Окно может сдвинуться раньше, чем закончит появляться" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding FastReaction}"
                                      AutomationProperties.Name="Мгновенная реакция" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Window size -->
            <TextBlock Text="Размер окна" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="{StaticResource RowPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Style="{StaticResource RowIcon}" Text="&#xE9A6;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Размер при центрировании" />
                            <TextBlock Style="{StaticResource RowDescription}"
                                       Text="По умолчанию окно сохраняет свой размер. Проценты считаются от рабочей области экрана без панели задач" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="{StaticResource RowPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Задать ширину" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding CustomWidth}"
                                  AutomationProperties.Name="Задать ширину" />
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="{Binding CustomWidth, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                                    Value="{Binding WidthPercent}"
                                    AutomationProperties.Name="Ширина окна в процентах" />
                            <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Medium"
                                       Text="{Binding WidthPercent, StringFormat={}{0}&#160;%}"
                                       Style="{StaticResource RowTitle}" />
                        </Grid>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="{StaticResource RowPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" Style="{StaticResource RowTitle}" Text="Задать высоту" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding CustomHeight}"
                                  AutomationProperties.Name="Задать высоту" />
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="{Binding CustomHeight, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                                    Value="{Binding HeightPercent}"
                                    AutomationProperties.Name="Высота окна в процентах" />
                            <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Medium"
                                       Text="{Binding HeightPercent, StringFormat={}{0}&#160;%}"
                                       Style="{StaticResource RowTitle}" />
                        </Grid>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="{StaticResource RowPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Менять размер у окон с фиксированным размером" />
                            <TextBlock Style="{StaticResource RowDescription}"
                                       Text="Размер меняется даже у окон, которые этого не поддерживают. Может исказить их вид" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding ForceResize}"
                                  AutomationProperties.Name="Менять размер у окон с фиксированным размером" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System -->
            <TextBlock Text="Система" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <Grid Margin="{StaticResource RowPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:Glyph Style="{StaticResource RowIcon}" Text="&#xE7E8;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Запускать вместе с Windows" />
                        <TextBlock Style="{StaticResource RowDescription}"
                                   Text="Программа стартует свёрнутой в трей. Управление — правой кнопкой по значку" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding Autostart}"
                              AutomationProperties.Name="Запускать вместе с Windows" />
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowDescription}" VerticalAlignment="Center" Margin="2,0,16,0"
                           Text="Версия 1.0 · основано на Window Centering Helper — Kamil Szymborski" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Выход" Command="{Binding ExitCommand}" MinWidth="96" Margin="0,0,8,0" />
                    <Button Content="Свернуть в трей" Command="{Binding HideToTrayCommand}" MinWidth="140"
                            Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
